+				auto ANFHalton = [](int32 Index, int32 Base)
+					{
+						Index = (Index + 1) % 16 + 1;
+						float Result = 0.0f;
+						float InvBase = 1.0f / float(Base);
+						float Fraction = InvBase;
+						while (Index > 0)
+						{
+							Result += float(Index % Base) * Fraction;
+							Index /= Base;
+							Fraction *= InvBase;
+						}
+						return Result;
+					};
+
+				int32_t sampleIndex = View.TemporalJitterIndex;
+
+				SampleX = ANFHalton(sampleIndex + 1, 2) - 0.5f;
+				SampleY = ANFHalton(sampleIndex + 1, 3) - 0.5f;
+
+				View.TemporalJitterPixels.X = SampleX;
+				View.TemporalJitterPixels.Y = SampleY;
+
+				View.ViewMatrices.HackAddTemporalAAProjectionJitter(FVector2D(SampleX * -2.0f / View.ViewRect.Width(), SampleY * -2.0f / View.ViewRect.Height()));
+			}
+			else
+			{
+				View.ViewMatrices.HackAddTemporalAAProjectionJitter(FVector2D(SampleX * 2.0f / View.ViewRect.Width(), SampleY * -2.0f / View.ViewRect.Height()));
+			}
